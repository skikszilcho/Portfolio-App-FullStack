# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:3000

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Supported values: gemini | openai | local-agent
LLM_PROVIDER=gemini

# Get your key from: https://aistudio.google.com/app/apikey
LLM_API_KEY=your-google-ai-studio-key-here

# Model to use (gemini-2.5-flash-lite is free tier)
LLM_MODEL=gemini-2.5-flash-lite

# ── Monitoring — Axiom (optional) ────────────────────────────────────────────
# Leave blank to fall back to console.log
# Get your key from: https://axiom.co
AXIOM_API_KEY=
AXIOM_DATASET=portfolio-events

# ── Quota database (SQLite) ───────────────────────────────────────────────────
# Path to the SQLite file that tracks RPD and per-session limits.
# Default resolves to backend/data/quota.db — no change needed for local dev.
QUOTA_DB_PATH=./data/quota.db