# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000                          # PORT_MAP: Portfolio-App backend — see PORT_MAP.md
CLIENT_URL=http://localhost:3010   # PORT_MAP: Portfolio-App frontend

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Supported values: gemini | openai | local-agent
LLM_PROVIDER=gemini

# Get your key from: https://aistudio.google.com/app/apikey
LLM_API_KEY=your-google-ai-studio-key-here

# Model to use (gemini-2.5-flash-lite is free tier)
LLM_MODEL=gemini-2.5-flash-lite

# ── Monitoring — Axiom (optional) ────────────────────────────────────────────
# Leave blank to fall back to console.log
# Get your key from: https://axiom.co
AXIOM_API_KEY=your-axiom-api-key-here
AXIOM_DATASET=portfolio-events

# ── Quota database (SQLite) ───────────────────────────────────────────────────
# Path to the SQLite file that tracks RPD and per-session limits.
# Default resolves to backend/data/quota.db — no change needed for local dev.
# Leave blank to use the default path: ./data/quota.db
QUOTA_DB_PATH=

# ── Email Relay (Phase 5) ─────────────────────────────────────────────────────
# Dedicated Gmail account used only for sending contact form emails.
# Requires 2FA enabled and an App Password generated in Google Account > Security.
GMAIL_USER=your-dedicated-sender@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
CONTACT_RECIPIENT_EMAIL=sebeshoikageng@outlook.com

# ── Cloudflare R2 (Phase 5) ───────────────────────────────────────────────────
# Credentials for the portfolio-cv R2 bucket.
# Generate via Cloudflare Dashboard > R2 > Manage R2 API Tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=portfolio-cv
R2_CV_OBJECT_KEY=cv.pdf